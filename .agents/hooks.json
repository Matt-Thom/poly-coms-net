{
  "hooks": [
    {
      "event": "PreToolUse",
      "command": "cmux report-agent --surface \"$CMUX_MUX_SURFACE\" --state working --source antigravity"
    },
    {
      "event": "PostToolUse",
      "command": "cmux report-agent --surface \"$CMUX_MUX_SURFACE\" --state idle --source antigravity"
    },
    {
      "event": "Stop",
      "command": "cmux report-agent --surface \"$CMUX_MUX_SURFACE\" --state done --source antigravity"
    }
  ]
}